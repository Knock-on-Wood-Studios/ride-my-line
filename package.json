{
  "name": "ride-my-line",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate-levels.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "check": "node --check game.js && node --check levels.js && npm run validate && npm run test:unit && npm run build",
    "build": "npm run validate && node scripts/build.mjs",
    "preview:test": "node scripts/serve.mjs dist 8765",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "matter-js": "^0.19.0"
  }
}
